# Copy to .env and fill in. Never commit .env.

# ElevenLabs (exact word timings). Used by default when set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Sarvam (natural Indian-English voices). Used when ElevenLabs is not set, or with provider "sarvam".
SARVAM_API_KEY=
# Optional overrides (defaults shown)
# SARVAM_MODEL=bulbul:v4-flash
# SARVAM_SPEAKER=shubh_en_narration
# SARVAM_LANGUAGE=en-IN
# SARVAM_PACE=1.07

# Optional: browser for capture_screen / rendering (default: Remotion's Chrome Headless Shell)
# VOX_BROWSER_PATH=
# Optional: force the video engine for screen footage: offthread | html5 (auto: html5 on Linux glibc < 2.35)
# VOX_VIDEO_ENGINE=
