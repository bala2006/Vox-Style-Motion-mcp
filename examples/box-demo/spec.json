    {
      "id": "how",
      "transition": "pushBottom",
      "narration": "Here is how this video was made. A script clicks through the app. The recording is mapped onto this voice. And every frame is rendered from code.",
      "elements": [
        {
          "type": "typewriter",
          "text": "HOW THIS VIDEO WAS MADE",
          "at": 14,
          "x": 120,
          "y": 46,
          "size": 24
        },
        {
          "type": "headline",
          "text": "No editor. / ==Just code.==",
          "align": "left",
          "x": 120,
          "y": 110,
          "size": 76,
          "width": 700,
          "at": "made"
        },
        {
          "type": "steps",
          "x": 120,
          "y": 360,
          "w": 620,
          "items": [
            {
              "tool": "capture_screen",
              "text": "app/index.html",
              "at": "clicks"
            },
            {
              "tool": "timeMap",
              "text": "recording -> narration words",
              "at": "mapped"
            },
            {
              "tool": "redact",
              "text": "payment key, every frame",
              "at": "voice"
            },
            {
              "tool": "render_video",
              "text": "1920 × 1080 · 30 fps",
              "at": "rendered",
              "highlight": true
            }
          ]
        },
        {
          "type": "terminal",
          "at": "script",
          "x": 900,
          "y": 300,
          "w": 900,
          "title": "VOX-STYLE-MOTION-MCP",
          "rotate": 1,
          "size": 28,
          "lines": [
            {
              "cmd": "capture_screen capture.json",
              "at": "clicks",
              "verdict": "13.5 S",
              "ok": true
            },
            {
              "cmd": "generate_voiceover --provider sarvam",
              "at": "voice",
              "verdict": "DONE",
              "ok": true
            },
            {
              "cmd": "render_video spec.voiced.json",
              "at": "rendered",
              "verdict": "MP4",
              "ok": true
            }
          ]
        }
      ]
    },
