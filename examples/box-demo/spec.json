          "type": "typewriter",
          "text": "BOX STYLE · A REAL APP, RECORDED START TO FINISH",
          "at": 4,
          "y": 46,
          "size": 26
        },
        {
          "type": "headline",
          "text": "Fifty orders an hour, / ==all in his head.==",
          "y": 120,
          "size": 84,
          "lineHeight": 1.18
        },
        {
          "type": "paperCard",
          "at": "head",
          "x": 300,
          "y": 420,
          "w": 560,
          "h": 200,
          "rotate": -3,
          "fill": "white",
          "kicker": "WHAT RAJU REMEMBERS",
          "body": "“3 cutting, 2 ginger, one bun maska, no sugar in the second one…”"
        },
        {
          "type": "arrow",
          "at": "head+8",
          "from": [
            900,
            560
          ],
          "to": [
            1080,
            600
          ],
          "bend": -0.3
        },
        {
          "type": "tag",
