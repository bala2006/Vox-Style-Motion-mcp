    {
      "id": "hook",
      "narration": "Every evening, Raju runs a chai stall in Bengaluru. Fifty orders an hour, all in his head. So we built him one small screen.",
      "transition": "cut",
      "elements": [
        {
          "at": 4,
          "type": "typewriter",
          "text": "BOX STYLE · A REAL APP, RECORDED START TO FINISH",
          "y": 46,
          "size": 26
        },
        {
          "type": "headline",
          "text": "Fifty orders an hour, / ==all in his head.==",
          "y": 120,
          "size": 84,
          "lineHeight": 1.18
        },
        {
          "at": "head",
          "type": "paperCard",
          "x": 300,
          "y": 420,
          "w": 560,
          "h": 200,
          "rotate": -3,
          "fill": "white",
          "kicker": "WHAT RAJU REMEMBERS",
          "body": "“3 cutting, 2 ginger, one bun maska, no sugar in the second one…”"
        },
        {
          "at": "head+8",
          "type": "arrow",
          "from": [
            900,
            560
          ],
          "to": [
            1080,
            600
          ],
          "bend": -0.3
        },
        {
          "at": "screen",
          "type": "tag",
          "text": "ONE SMALL SCREEN",
          "x": 1120,
          "y": 560,
          "size": 54,
          "rotate": 4,
          "color": "yellow"
        },
        {
          "at": "built",
          "type": "stamp",
          "text": "NO NOTEBOOK",
          "x": 760,
          "y": 760,
          "rotate": -6,
          "size": 72
        },
        {
          "at": "head",
          "type": "tape",
          "x": 520,
          "y": 395,
          "w": 130,
          "rotate": -6
        }
      ]
    },
