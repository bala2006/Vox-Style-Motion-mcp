          "y": 700,
          "to": 85,
          "prefix": "₹",
          "size": 150,
          "label": "SAME ORDER, SAME TOTAL"
        }
      ]
    },
    {
      "id": "close",
      "narration": "Real software, in a box, in your own voice.",
      "background": "black",
      "transition": "pushBottom",
      "elements": [
        {
          "type": "headline",
          "text": "Real software, / in a box, / ==in your own voice.==",
