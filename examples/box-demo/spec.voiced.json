    {
      "id": "how",
      "narration": "Here is how this video was made. A script clicks through the app. The recording is mapped onto this voice. And every frame is rendered from code.",
      "transition": "pushBottom",
      "elements": [
        {
          "at": 14,
          "type": "typewriter",
          "text": "HOW THIS VIDEO WAS MADE",
          "x": 120,
          "y": 46,
          "size": 24
        },
        {
          "at": "made",
          "type": "headline",
          "text": "No editor. / ==Just code.==",
          "x": 120,
          "y": 110,
          "align": "left",
          "size": 76,
          "width": 700
        },
        {
          "type": "steps",
          "x": 120,
          "y": 360,
          "w": 620,
          "items": [
            {
              "text": "app/index.html",
              "tool": "capture_screen",
              "at": "clicks"
            },
            {
              "text": "recording -> narration words",
              "tool": "timeMap",
              "at": "mapped"
            },
            {
              "text": "payment key, every frame",
              "tool": "redact",
              "at": "voice"
            },
            {
              "text": "1920 × 1080 · 30 fps",
              "tool": "render_video",
              "at": "rendered",
              "highlight": true
            }
          ]
        },
        {
          "at": "script",
          "type": "terminal",
          "x": 900,
          "y": 300,
          "w": 900,
          "title": "VOX-STYLE-MOTION-MCP",
          "rotate": 1,
          "size": 28,
          "lines": [
            {
              "cmd": "capture_screen capture.json",
              "at": "clicks",
              "verdict": "13.5 S",
              "ok": true
            },
            {
              "cmd": "generate_voiceover --provider sarvam",
              "at": "voice",
              "verdict": "DONE",
              "ok": true
            },
            {
              "cmd": "render_video spec.voiced.json",
              "at": "rendered",
              "verdict": "MP4",
              "ok": true
            }
          ]
        }
      ]
    },
    {
      "id": "phone",
      "narration": "And on his phone, the same page fits in one hand.",
      "transition": "pushRight",
      "elements": [
        {
          "type": "headline",
          "text": "Same page, / ==one hand.==",
          "x": 150,
          "y": 300,
